# ===========================================
# VARIABLES DE ENTORNO PARA PRODUCCION (Railway)
# ===========================================
# Copia este archivo como .env en desarrollo o configura estas variables en Railway

# -------------------------------------------
# BASE DE DATOS (Railway las provee automaticamente)
# -------------------------------------------
# Opcion 1: Usar DATABASE_URL (recomendado en Railway)
DATABASE_URL=postgresql://usuario:password@host:5432/gestion_db

# Opcion 2: Variables individuales
PGHOST=localhost
PGPORT=5432
PGDATABASE=gestion_db
PGUSER=postgres
PGPASSWORD=tu_password_seguro

# -------------------------------------------
# SEGURIDAD - JWT (OBLIGATORIO EN PRODUCCION)
# -------------------------------------------
# Generar con: openssl rand -base64 64
# El valor debe tener al menos 43 caracteres (256 bits)
JWT_SECRET=

# -------------------------------------------
# CORS - Orígenes permitidos (produccion)
# -------------------------------------------
# Lista separada por comas de URLs que pueden acceder a la API
CORS_ALLOWED_ORIGINS=https://tu-dominio.com,https://app.tu-dominio.com

# -------------------------------------------
# PERFIL DE SPRING
# -------------------------------------------
# Usar 'prod' en produccion, 'dev' en desarrollo
SPRING_PROFILES_ACTIVE=prod

# -------------------------------------------
# PUERTO (Railway lo asigna automaticamente)
# -------------------------------------------
PORT=8080
